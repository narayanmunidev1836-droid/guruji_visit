# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Every variable is validated at runtime by src/lib/env.js - the app tells you what is missing.

# --- Required -----------------------------------------------------------------------------------
# PostgreSQL connection string (Prisma 7 + pg driver adapter).
DATABASE_URL="postgresql://guruji:CHANGE_ME@localhost:5432/guruji_archive"

# Signs login sessions and "open original" links. At least 32 random characters, different per environment.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"

# --- Optional (defaults shown) --------------------------------------------------------------------
# Public address of the site (used in docs / future e-mails; not a secret).
APP_URL="http://localhost:3000"

# Who may see (and search by) full mobile numbers. Others see ••••••123. Comma separated: ADMIN,STAFF
MOBILE_VISIBLE_ROLES="ADMIN,STAFF"

# Optional: direct / session-mode connection used by the Prisma CLI (`db:deploy`, `db:migrate`) when DATABASE_URL
# points to a transaction-mode pooler (e.g. Supabase port 6543). Falls back to DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Development only -----------------------------------------------------------------------------
# prisma migrate dev on the embedded `prisma dev` server needs a shadow database URL (see docs/SETUP.md).
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# Fixed administrator login, used by `npm run db:seed` (run it once per database - the admin stays in the DB).
# With SEED_ADMIN_PASSWORD set, the admin SEED_ADMIN_EMAIL is created, or its password re-set if the seed is run again.
# Without it, an admin is created only if none exists and a random password is printed once.
# SEED_ADMIN_EMAIL="admin@example.org"
# SEED_ADMIN_NAME="Administrator"
# SEED_ADMIN_PASSWORD="choose-a-long-password"
